OPENAI_API_KEY=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=true

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false
# Code research configuration (CLI --repository or API configurable.repository_path also works)
# REPOSITORY_PATH=D:/path/to/repository
REPOSITORY_ALLOW_WEB=false
HISTORY_ENABLED=true
# Shared SQLite file: repository_snapshots + research_history
# RESEARCH_DATABASE=.research-history/history.sqlite3
# HISTORY_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Wiki generation is explicit; reading existing Wiki pages is optional.
WIKI_ENABLED=true
# WIKI_BUSINESS_DIR=docs/business
# WIKI_MAX_BUSINESS_TOPICS=30
# WIKI_MODEL=openai:gpt-4.1
# WIKI_MAX_MODULES=100
# WIKI_CONTEXT_CHARS=24000
# WIKI_MAX_TOKENS=3000
# WIKI_TIMEOUT_SECONDS=90
